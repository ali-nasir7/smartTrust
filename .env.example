# ============================================================================
# SmartTrust Backend — Environment Variables Example
# Copy this file to `.env` (same folder as pom.xml) and fill in real values.
# `.env` is in .gitignore and is NEVER committed to Git.
# Spring Boot loads it automatically (spring.config.import=optional:file:.env)
# You can also `set` these in CMD instead of using .env — see SETUP-GUIDE.md
# ============================================================================

# ---------- Database (MySQL 8.x) ----------
DB_URL=jdbc:mysql://localhost:3306/smarttrust?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=your_mysql_root_password

# ---------- JWT (REQUIRED in production — use a random 64+ char string) ----------
JWT_SECRET=change-me-to-a-random-string-of-at-least-64-characters-0123456789ABCDEF

# ---------- OTP policy (all optional, sensible defaults) ----------
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MOCK_ENABLED=true logs the OTP to the server console (DEV ONLY — never in production).
# Use it only when you cannot configure SMTP yet.
OTP_MOCK_ENABLED=false

# ---------- SMTP / Email (REQUIRED for real email OTP delivery) ----------
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=<your@gmail.com>,
# SMTP_PASSWORD=<16-char Google App Password> (needs 2-Step Verification enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your16charapppassword
MAIL_FROM=yourgmail@gmail.com
MAIL_FROM_NAME=SmartTrust

# ---------- Admin bootstrap (OPTIONAL — creates admin on first boot) ----------
# Set both to create an ADMIN account automatically if the phone is not registered.
ADMIN_PHONE=03001234567
ADMIN_EMAIL=admin@smarttrust.pk
ADMIN_PASSWORD=Admin@123

# ---------- File uploads (CNIC / selfie storage) ----------
# Absolute path recommended in production, e.g. D:/smarttrust-uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_MB=5
UPLOAD_MAX_REQUEST_MB=20
UPLOAD_MAX_FILE_BYTES=5242880
