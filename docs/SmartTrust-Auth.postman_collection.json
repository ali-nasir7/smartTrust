{
  "info": {
    "name": "SmartTrust Auth Module - FYP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Init",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "body": {
          "mode":"raw",
          "raw":"{\n  \"phone\": \"03001234567\",\n  \"password\": \"Test@1234\",\n  \"role\": \"CUSTOMER\",\n  \"fullName\": \"Ali Nasir\"\n}"
        },
        "url": {"raw":"{{baseUrl}}/api/v1/auth/register/init","host":["{{baseUrl}}"],"path":["api","v1","auth","register","init"]}
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method":"POST",
        "header":[{"key":"Content-Type","value":"application/json"}],
        "body":{"mode":"raw","raw":"{\n  \"phone\": \"03001234567\",\n  \"otp\": \"123456\"\n}"},
        "url":{"raw":"{{baseUrl}}/api/v1/auth/verify-otp","host":["{{baseUrl}}"],"path":["api","v1","auth","verify-otp"]}
      }
    },
    {
      "name": "Login",
      "request": {
        "method":"POST",
        "header":[{"key":"Content-Type","value":"application/json"}],
        "body":{"mode":"raw","raw":"{\n  \"phone\": \"03001234567\",\n  \"password\": \"Test@1234\",\n  \"deviceInfo\": \"Postman Windows\"\n}"},
        "url":{"raw":"{{baseUrl}}/api/v1/auth/login","host":["{{baseUrl}}"],"path":["api","v1","auth","login"]}
      }
    },
    {
      "name": "Refresh",
      "request": {
        "method":"POST",
        "header":[{"key":"Content-Type","value":"application/json"}],
        "body":{"mode":"raw","raw":"{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"},
        "url":{"raw":"{{baseUrl}}/api/v1/auth/refresh","host":["{{baseUrl}}"],"path":["api","v1","auth","refresh"]}
      }
    },
    {
      "name": "Logout",
      "request": {
        "method":"POST",
        "header":[{"key":"Content-Type","value":"application/json"}],
        "body":{"mode":"raw","raw":"{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"},
        "url":{"raw":"{{baseUrl}}/api/v1/auth/logout","host":["{{baseUrl}}"],"path":["api","v1","auth","logout"]}
      }
    },
    {
      "name": "Forgot Password Init",
      "request": {
        "method":"POST",
        "header":[{"key":"Content-Type","value":"application/json"}],
        "body":{"mode":"raw","raw":"{\n  \"phone\": \"03001234567\"\n}"},
        "url":{"raw":"{{baseUrl}}/api/v1/auth/forgot-password/init","host":["{{baseUrl}}"],"path":["api","v1","auth","forgot-password","init"]}
      }
    },
    {
      "name": "Forgot Password Reset",
      "request": {
        "method":"POST",
        "header":[{"key":"Content-Type","value":"application/json"}],
        "body":{"mode":"raw","raw":"{\n  \"phone\": \"03001234567\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPass@1234\"\n}"},
        "url":{"raw":"{{baseUrl}}/api/v1/auth/forgot-password/reset","host":["{{baseUrl}}"],"path":["api","v1","auth","forgot-password","reset"]}
      }
    }
  ],
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"refreshToken","value":""},
    {"key":"accessToken","value":""}
  ]
}
